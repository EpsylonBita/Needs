# Copy to ignored .env.local. Never put real secrets in this template.
# Required: use the URL and keys from the SAME Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public browser configuration
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3002
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_PAYMENTS_ENABLED=false
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Leave blank locally; set only when a production cookie domain is needed.
NEXT_PUBLIC_DOMAIN=

# Server-only Stripe credentials (test mode for local development)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Separate random server-only value (32+ characters) for payment reconciliation.
# Local dev:payments generates an ephemeral value when this is blank.
PAYMENTS_WORKER_SECRET=

# Optional server-managed admin allowlist. Trusted app_metadata.role also works.
ADMIN_EMAILS=

# Deferred contact-email setup: verified sender, monitored recipient and Resend key.
RESEND_API_KEY=
CONTACT_EMAIL_FROM=
CONTACT_NOTIFY_TO=
# Random server-only value, at least 32 characters, for the dispatch worker.
CRON_SECRET=
