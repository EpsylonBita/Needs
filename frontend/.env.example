# Copy to ignored .env.local. Never put real secrets in this template.
# Required: use the URL and keys from the SAME Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public browser configuration
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3002
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_PAYMENTS_ENABLED=false
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Leave blank locally; set only when a production cookie domain is needed.
NEXT_PUBLIC_DOMAIN=

# Server-only Stripe credentials (test mode for local development)
# Use keys, Connect providers and webhook secret from ONE explicitly selected NEEDS
# account/environment. Never copy another project's keys or switch active orders.
# A later live environment needs its own verified keys/endpoint; this template
# enables nothing and does not contain sandbox or live credentials.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Separate random server-only value (32+ characters) for payment reconciliation.
# Local dev:payments generates an ephemeral value when this is blank.
PAYMENTS_WORKER_SECRET=
# Optional private absolute health-file path for a supervised worker.
# See docs/payments-worker-operations.md. Each worker needs its own path.
PAYMENTS_WORKER_HEALTH_FILE=

# Optional server-managed admin allowlist. Trusted app_metadata.role also works.
ADMIN_EMAILS=

# Deferred contact-email setup: verified sender, monitored recipient and Resend key.
# Keep these blank until an actual owned sender domain and recipient are verified.
# Mock support@needs.invalid / privacy@needs.invalid are DISPLAY ONLY, never senders.
# Supabase Auth SMTP and Stripe receipts are configured separately in their own
# services; these variables do not configure password-reset emails or receipts.
# Payment-expiry warnings are currently in-app, not an email-delivery feature.
RESEND_API_KEY=
CONTACT_EMAIL_FROM=
CONTACT_NOTIFY_TO=
# Random server-only value, at least 32 characters, for the dispatch worker.
CRON_SECRET=
